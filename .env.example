# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is gitignored. Never commit real keys.

# LaunchDarkly SDK key (SECRET, server only). Starts with "sdk-".
# Replace with your own: LaunchDarkly > gear icon > Organization settings >
# SDK keys > pick your project and environment > copy the SDK key.
LD_SDK_KEY=sdk-your-sdk-key-here

# LaunchDarkly client-side ID (public, safe in the browser). No dashes.
# Same page as the SDK key: copy the client-side ID for the same environment.
LD_CLIENT_SIDE_ID=your-client-side-id-here

# The LaunchDarkly environment the keys above belong to. The demo uses production.
LD_ENVIRONMENT=production

# LaunchDarkly API access token (SECRET). Starts with "api-". Used by the
# bootstrap, reset, and doctor scripts, not by the app itself.
# Create one: gear icon > Authorization > Create token (Writer role).
LD_API_TOKEN=api-your-api-token-here

# Port the Express server listens on.
PORT=3000

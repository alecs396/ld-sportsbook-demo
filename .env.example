# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is gitignored. Never commit real keys.

# LaunchDarkly SDK key (SECRET, server only). Starts with "sdk-".
# `make bootstrap` fills this in for you from LD_API_TOKEN.
# Replace with your own: LaunchDarkly > gear icon > Organization settings >
# SDK keys > pick your project and environment > copy the SDK key.
LD_SDK_KEY=sdk-your-sdk-key-here

# LaunchDarkly client-side ID (public, safe in the browser). No dashes.
# Same page as the SDK key: copy the client-side ID for the same environment.
# `make bootstrap` fills this in for you from LD_API_TOKEN.
LD_CLIENT_SIDE_ID=your-client-side-id-here

# The LaunchDarkly project and environment the keys above belong to. Used by
# the doctor, demo-reset, and bootstrap scripts. The demo uses production.
LD_PROJECT_KEY=ld-sportsbook-demo
LD_ENVIRONMENT=production

# LaunchDarkly API access token (SECRET). Starts with "api-". Used by the
# bootstrap, reset, and doctor scripts, not by the app itself.
# Create one: gear icon > Authorization > Create token (Writer role).
LD_API_TOKEN=api-your-api-token-here

# Flag trigger URL for "live-betting" (SECRET: anyone with it can flip the flag).
# Create it: live-betting > Production > three-dot menu > Configuration in
# environment > Triggers > Add trigger > Generic trigger > "Turn off flag".
# The URL is shown only once. Used by `make fire-trigger` and the simulator.
LD_TRIGGER_URL=paste-your-trigger-url-here

# Anthropic API key for the bet assistant chatbot (SECRET, server only).
# Create one at console.anthropic.com > API keys. Optional: without it the
# chatbot replies with a "not configured" message and the rest of the app works.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Port the Express server listens on.
PORT=3000
